{
  "name": "ngx-neo",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "update": "nx migrate latest",
    "serve neo": "nx serve ngx-neo",
    "build neo": "nx run ngx-neo:build",
    "build prerender": "nx run ngx-neo:prerender",
    "build ui": "nx build lib-ui",
    "publish ui": "cd dist/ui && npm publish",
    "dev:ssr": "ng run ngx-neo:serve-ssr",
    "serve:ssr": "node dist/ngx-neo/server/main.js",
    "prerender": "ng run ngx-neo:prerender",
    "serve backend": "nx serve my-pages-api",
    "build my-pages": "nx build my-pages",
    "serve my-pages": "nx dev my-pages",
    "prepare": "husky install",
    "lint": "ng lint",
    "prettier": "prettier --write ./src"
  },
  "lint-staged": {
    "*.{json,html,scss}": [
      "prettier --write ./",
      "git add"
    ],
    "*.{js,ts}": [
      "prettier --write ./",
      "eslint --fix --cache",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "npx lint-staged"
    }
  },
  "private": true,
